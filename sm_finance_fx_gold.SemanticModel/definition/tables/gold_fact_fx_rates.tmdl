table gold_fact_fx_rates
	lineageTag: ea19621f-501d-4031-9492-cd8025ea9f72
	sourceLineageTag: [dbo].[gold_fact_fx_rates]

	measure 'Latest FX Rate Label' =
			
			FORMAT(AVERAGE(gold_fact_fx_rates[exchange_rate]), "0.00") & " " & SELECTEDVALUE(gold_dim_currency[currency_code])
		lineageTag: f15c95d4-43e6-44e3-a0db-a1bf2fdec7d6

		changedProperty = Name

	measure '45D High Low Range' =
			
			FORMAT(MAX(gold_fact_fx_rates[exchange_rate]), "0.00") & " / " & FORMAT(MIN(gold_fact_fx_rates[exchange_rate]), "0.00")
		lineageTag: 6e8bf719-51d4-4c91-983d-fb9cd83d0a44

		changedProperty = Name

	measure '45-Day Change (%)' = ```
			
			VAR _MaxDate = MAX('gold_fact_fx_rates'[rate_date])
			
			VAR _FirstActualDate = 
			    CALCULATE(
			        MIN('gold_fact_fx_rates'[rate_date]),
			        'gold_fact_fx_rates'[rate_date] >= _MaxDate - 42,
			        NOT(ISBLANK('gold_fact_fx_rates'[exchange_rate]))
			    )
			
			VAR _LatestRate = 
			    CALCULATE(
			        AVERAGE('gold_fact_fx_rates'[exchange_rate]),
			        'gold_fact_fx_rates'[rate_date] = _MaxDate
			    )
			
			VAR _StartRate = 
			    CALCULATE(
			        AVERAGE('gold_fact_fx_rates'[exchange_rate]),
			        'gold_fact_fx_rates'[rate_date] = _FirstActualDate
			    )
			
			RETURN
			    DIVIDE(_LatestRate - _StartRate, _StartRate)
			
			```
		lineageTag: dbd9a268-26e2-4dd9-9026-a803261be066

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'All Economies GDP (USD)' =
			
			CALCULATE(
			    SUM(gold_dim_currency[gdp_trillions_usd]),
			    REMOVEFILTERS(gold_dim_currency[currency_code])
			)
		lineageTag: 1b720282-6d95-4ae9-b23a-452c164c9a56

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

